# ===== APP =====
API_PORT=4000
# Local: http://localhost:9999  |  VPS example: http://YOUR_IP:9999
APP_URL=http://localhost:9999
# Backend URL for Next.js API rewrites (same machine → 127.0.0.1)
API_URL=http://127.0.0.1:4000
SESSION_SECRET=change_me_min_32_chars_long_secret
# openssl rand -hex 32  (encrypts YouTube refresh token)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== DB / REDIS =====
DATABASE_URL=postgresql://shorts:password@localhost:5433/shorts_db
# Own compose Redis on 6380 (avoids host Redis with password on 6379)
REDIS_URL=redis://127.0.0.1:6380

# ===== STORAGE =====
STORAGE_ROOT=./data
DISK_BLOCK_NEW_JOBS_PCT=85
MIN_FREE_GB=10
DOWNLOAD_SPACE_MULTIPLIER=3
ORIGINAL_RETENTION_DAYS=2
CLIP_RETENTION_DAYS=14

# ===== VIDEO =====
MAX_VIDEO_DURATION_MIN=60
MAX_UPLOAD_SIZE_MB=2048
CLIP_MIN_SEC=30
CLIP_MAX_SEC=55
CLIPS_PER_VIDEO=5
FFMPEG_PRESET=veryfast
DEFAULT_TEMPLATE_ID=default
THUMBNAILS_ENABLED=true
YTDLP_COOKIES_PATH=

# ===== AI =====
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Host apps talk to Docker-published Ollama (docker compose up -d ollama).
OLLAMA_HOST=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_DISABLED=false

# ===== WORKERS =====
HEAVY_SLOTS=1
WORKER_DOWNLOAD_CONCURRENCY=2
WORKER_TRANSCRIBE_CONCURRENCY=1
WORKER_ANALYZE_CONCURRENCY=1
WORKER_RENDER_CONCURRENCY=1
WORKER_PUBLISH_CONCURRENCY=1

# ===== YOUTUBE =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prefer same host as APP_URL (via Next /api proxy), e.g. http://YOUR_IP:9999/api/youtube/callback
GOOGLE_REDIRECT_URI=http://localhost:9999/api/youtube/callback
YT_DEFAULT_PRIVACY=public
YT_DEFAULT_CATEGORY_ID=22
YT_DRY_RUN=true
